<?xml version="1.0" encoding="utf-8"?>
<!--
  Pagenor MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build pagenor.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files with a Start Menu shortcut.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Pagenor"
      Manufacturer="Appaji Ambarisha"
      Version="$(var.Version)"
      UpgradeCode="19F2117E-82B7-5119-851F-D573BE3EE68E"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Pagenor page layout and publishing" Manufacturer="Appaji Ambarisha" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Pagenor is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="PagenorIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="PagenorIcon.ico" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Pagenor" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Pagenor" Level="1">
      <ComponentGroupRef Id="PagenorFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="PagenorFiles" Directory="INSTALLFOLDER">
      <Component Id="PagenorApp" Guid="54E2E178-B8D0-54DC-B725-D4F32DDA891F">
        <File Id="PagenorExe" Source="$(var.BinDir)\pagenor.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Pagenor"
              Description="Pagenor page layout and publishing" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="PagenorIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\pagenor.exe" Value="[#PagenorExe]" Type="string" />
      </Component>

      <Component Id="PagenorCli">
        <File Id="PagenorCliExe" Source="$(var.BinDir)\pagenor-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
