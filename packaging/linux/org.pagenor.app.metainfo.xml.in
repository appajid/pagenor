<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>org.pagenor.app</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Pagenor</name>
  <summary>Lay out magazines, books and print documents</summary>
  <developer id="org.pagenor">
    <name>Appaji Ambarisha</name>
  </developer>
  <description>
    <p>
      Pagenor is a page-layout and publishing application for creating magazines,
      books and print documents with text frames, typography, images and reusable styles.
    </p>
  </description>
  <url type="homepage">https://github.com/appajid/pagenor</url>
  <url type="bugtracker">https://github.com/appajid/pagenor/issues</url>
  <launchable type="desktop-id">org.pagenor.app.desktop</launchable>
  <icon type="stock">org.pagenor.app</icon>
  <categories>
    <category>Graphics</category>
    <category>VectorGraphics</category>
  </categories>
  <keywords>
    <keyword>publishing</keyword>
    <keyword>page layout</keyword>
    <keyword>typography</keyword>
    <keyword>layers</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#1455F6</color>
    <color type="primary" scheme_preference="dark">#09172F</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>pagenor</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
